---
import CallToAction from './CallToAction.astro';
import Icon from './Icon.astro';
---

<aside>
    <h2>Send me a message</h2>
    <div>
        <CallToAction href="https://matrix.to/#/@timurinal:matrix.org">
            Matrix
            <Icon icon="matrix-logo" size="1.2em" />
        </CallToAction>
        <CallToAction href="mailto:hello@timurinal.co.uk">
            Email
            <Icon icon="paper-plane-tilt" size="1.2em" />
        </CallToAction>
    </div>
</aside>

<style>
    aside {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 3rem;
        border-top: 1px solid var(--gray-800);
        border-bottom: 1px solid var(--gray-800);
        padding: 5rem 1.5rem;
        background-color: var(--gray-999_40);
        box-shadow: var(--shadow-sm);
    }

    div {
        display: flex;
        flex-direction: row;
        /* Allow buttons to wrap instead of overflowing on small widths */
        flex-wrap: wrap;
        justify-content: center;
        gap: 1rem;
        align-items: center;
    }

    h2 {
        font-size: var(--text-xl);
        text-align: center;
        max-width: 15ch;
    }

    @media (min-width: 50em) {
        aside {
            padding: 7.5rem;
            flex-direction: row;
            flex-wrap: wrap;
            /* Center rows/items on medium “square-ish” viewports */
            justify-content: center;
        }

        h2 {
            font-size: var(--text-3xl);
            /* Keep centered when wrapping at this breakpoint */
            text-align: center;
        }
    }
    /* On larger desktop widths, restore the split layout */
    @media (min-width: 70em) {
        aside {
            justify-content: space-between;
        }
        h2 {
            text-align: left;
        }
    }
</style>
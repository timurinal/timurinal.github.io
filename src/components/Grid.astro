---
interface Props {
    variant?: 'offset' | 'small' | 'medium' | 'large';
}

const { variant } = Astro.props;
---

<ul class:list={['grid', { offset: variant === 'offset', small: variant === 'small', medium: variant === 'medium', large: variant === 'large' }]}>
    <slot />
</ul>

<style>
    .grid {
        display: grid;
        grid-auto-rows: 1fr;
        gap: 1rem;
        list-style: none;
        padding: 0;
    }

    .grid.small {
        grid-template-columns: 1fr 1fr;
        gap: 1.5rem;
    }

    /* If last row contains only one item, make it span both columns. */
    .grid.small > :global(:last-child:nth-child(odd)) {
        grid-column: 1 / 3;
    }

    .grid.medium {
        grid-template-columns: 1fr 1fr;
        gap: 2rem;
    }

    /* If last row contains only one item, make it span both columns. */
    .grid.medium > :global(:last-child:nth-child(odd)) {
        grid-column: 1 / 3;
    }

    /* Large variant
       - 2 columns (on wide screens)
       - First item spans full width
       - If the last row has a single item, center it */
    .grid.large {
        grid-template-columns: 1fr;
        gap: 1.5rem;
    }
    .grid.large > :global(:first-child) {
        grid-column: 1 / -1;
    }
    .grid.large > :global(:last-child:nth-child(odd)) {
        grid-column: 1 / -1;
        justify-self: center;
        /* Optional: keep reasonable width when centered on small screens */
        width: min(100%, 40rem);
    }

    @media (min-width: 50em) {
        .grid {
            grid-template-columns: 1fr 1fr;
            gap: 4rem;
        }

        .grid.offset {
            --row-offset: 7.5rem;
            padding-bottom: var(--row-offset);
        }

        /* Shift first item in each row vertically to create staggered effect. */
        .grid.offset > :global(:nth-child(odd)) {
            transform: translateY(var(--row-offset));
        }

        /* If last row contains only one item, display it in the second column. */
        .grid.offset > :global(:last-child:nth-child(odd)) {
            grid-column: 2 / 3;
            transform: none;
        }

        .grid.small {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 2rem;
        }

        .grid.small > :global(*) {
            flex-basis: 20rem;
        }

        .grid.medium {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 2.5rem;
        }

        .grid.medium > :global(*) {
            flex-basis: 26rem;
        }

        /* Large variant (desktop) */
        .grid.large {
            grid-template-columns: 1fr 1fr;
            gap: 4rem;
        }
        .grid.large > :global(:first-child) {
            grid-column: 1 / -1; /* full-width hero */
        }
        .grid.large > :global(:last-child:nth-child(odd)) {
            grid-column: 1 / -1; /* center single item row */
            justify-self: center;
            width: auto;
        }
    }
</style>